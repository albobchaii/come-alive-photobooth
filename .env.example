# Salin ke .env untuk development lokal. Semua boleh kosong:
# tanpa DATABASE_URL → PGlite lokal, tanpa SUPABASE_URL → folder .data/uploads.

PORT=3001

# --- Supabase: Project Settings → Database → Connection string ---
# Transaction pooler (port 6543) untuk server / Vercel.
DATABASE_URL=
# Session pooler (port 5432) untuk migrasi & skrip device (npm run db:migrate / device).
DATABASE_URL_DIRECT=

# --- Supabase: Project Settings → API Keys ---
SUPABASE_URL=
# Secret key (sb_secret_…) atau service_role key. RAHASIA: jangan taruh di frontend.
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=softfile

# Berapa hari softfile disimpan.
RETENTION_DAYS=30

# Rahasia untuk endpoint cron pembersihan (string acak panjang).
CRON_SECRET=

# Password panel admin (/admin). Minimal 12 karakter, kosong = admin dimatikan.
ADMIN_PASSWORD=
